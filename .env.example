# ==============================================================================
# LaunchForge environment variables
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# `.env*` is git-ignored — never commit real keys.
# ==============================================================================

# --- Supabase (REQUIRED for real authentication + shared data) ----------------
# Find these in: Supabase Dashboard -> Project Settings -> API
#
# The anon key is a PUBLIC key that is safe to expose in the browser bundle.
# NEVER put a `service_role` key here — it would be bundled into the client.
VITE_SUPABASE_URL="https://ebmltadqatahmnigmupa.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-PUBLIC-ANON-KEY"

# --- Optional -----------------------------------------------------------------
# Where OAuth (GitHub/Google) redirects after signing in.
# Add this exact URL to Supabase -> Authentication -> URL Configuration.
# APP_URL="http://localhost:3000"
